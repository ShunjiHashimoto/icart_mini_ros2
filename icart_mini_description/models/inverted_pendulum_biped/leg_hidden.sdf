<?xml version="1.0"?>
<sdf version="1.9">
  <model name="biped_leg_hidden">
    <!-- Fortressのgpu_lidarはrendering由来なので、visualを消すとscan対象が変わる。
         GUI上では透明にしつつ、LiDAR用のrendering geometryとcollisionは残す。 -->
    <static>true</static>
    <link name="leg">
      <pose>0 0 0.35 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.70</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <!-- 536870913 = GUI表示bit(1) + LiDAR専用bit(0x20000000)。
             visualを消すとgpu_lidarからも消えるため、透明化だけして/scanには残す。 -->
        <visibility_flags>536870913</visibility_flags>
        <transparency>1.0</transparency>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.70</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.18 0.85 0.0</ambient>
          <diffuse>0.08 0.18 0.85 0.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
