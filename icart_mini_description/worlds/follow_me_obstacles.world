<?xml version="1.0"?>
<sdf version="1.6">
  <world name="follow_me_obstacles">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <remapping>model_states:=model_states</remapping>
        <remapping>link_states:=link_states</remapping>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="left_wall">
      <static>true</static>
      <pose>1.2 0.85 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 0.08 0.70</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.08 0.70</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_wall">
      <static>true</static>
      <pose>1.2 -0.85 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 0.08 0.70</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.08 0.70</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_obstacle_front_left">
      <static>true</static>
      <pose>0.95 0.38 0.22 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.22 0.22 0.44</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.22 0.22 0.44</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.30 0.22 1</ambient>
            <diffuse>0.35 0.30 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_obstacle">
      <static>true</static>
      <pose>1.55 -0.35 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.09</radius>
              <length>0.70</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.09</radius>
              <length>0.70</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.30 0.40 0.50 1</ambient>
            <diffuse>0.30 0.40 0.50 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
